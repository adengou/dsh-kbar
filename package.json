{
  "name": "dsh-kbar",
  "version": "0.3.3",
  "description": "KBar: a command palette for DeepSeek Harness — one shortcut to search sessions and run common actions.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "command-palette",
    "quick-open",
    "search"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "engines": {
    "node": ">=20.12",
    "dsh": ">=0.2.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/adengou/dsh-kbar.git"
  },
  "homepage": "https://github.com/adengou/dsh-kbar",
  "bugs": {
    "url": "https://github.com/adengou/dsh-kbar/issues"
  },
  "author": "adengou",
  "publishConfig": {
    "access": "public"
  }
}
